# Den här filen droppas av nginx:alpine:s inbyggda envsubst-mall-mekanism i
# /etc/nginx/conf.d/ - alltså REDAN inuti bas-imagens egen http{}-block. Lägg
# aldrig till worker_processes/events{}/http{} här, bara map/server-direktiv.
map $http_upgrade $connection_upgrade {
    default upgrade;
    ''      close;
}

server {
        listen 8199 ssl;
        server_name ${DOMAIN};
        resolver 127.0.0.11 valid=30s;
        ssl_certificate     /certs/fullchain.pem;
        ssl_certificate_key /certs/privkey.pem;
        client_max_body_size 0;

        location /energywizard/mobil/ {
            rewrite ^/energywizard/mobil/(.*)$ /$1 break;
            proxy_pass http://ewapp:8502;
            proxy_http_version 1.1;
            proxy_set_header Upgrade $http_upgrade;
            proxy_set_header Connection $connection_upgrade;
            proxy_set_header Host $host;
            proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
            proxy_set_header X-Forwarded-Proto https;
        }
        location = /energywizard/mobil { return 301 /energywizard/mobil/; }

        location /tablet/ {
            rewrite ^/tablet/(.*)$ /$1 break;
            proxy_pass http://ewapp:8502;
            proxy_http_version 1.1;
            proxy_set_header Upgrade $http_upgrade;
            proxy_set_header Connection $connection_upgrade;
            proxy_set_header Host $host;
            proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
            proxy_set_header X-Forwarded-Proto https;
        }
        location = /tablet { return 301 /tablet/; }

        location /energywizard/ {
            rewrite ^/energywizard/(.*)$ /$1 break;
            proxy_pass http://webdashboard:8503;
            proxy_http_version 1.1;
            proxy_set_header Upgrade $http_upgrade;
            proxy_set_header Connection $connection_upgrade;
            proxy_set_header Host $host;
            proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
            proxy_set_header X-Forwarded-Proto https;
        }
        location = /energywizard { return 301 /energywizard/; }

        location /telemetry/ {
            rewrite ^/telemetry/(.*)$ /$1 break;
            proxy_pass http://telemetry-collector:8504;
            proxy_http_version 1.1;
            proxy_set_header Host $host;
            proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
            proxy_set_header X-Forwarded-Proto https;
        }
        location = /telemetry { return 301 /telemetry/; }

        # Allt annat -> din Home Assistant. HA_PROTO=https om din HA terminerar egen TLS
        # (vanligt för Container-installationer med ett eget certifikat), annars http.
        location / {
            proxy_pass ${HA_PROTO}://${HA_HOST}:${HA_PORT};
            proxy_ssl_verify off;
            proxy_http_version 1.1;
            proxy_set_header Upgrade $http_upgrade;
            proxy_set_header Connection $connection_upgrade;
            proxy_set_header Host $host;
            proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
            proxy_set_header X-Forwarded-Proto https;
            proxy_read_timeout 240;
        }
    }
