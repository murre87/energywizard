# Optional hardened build; authenticate to dhi.io before building.
FROM dhi.io/python:3.11-debian13-dev@sha256:5718cc9f67bccbb0b54c9badc50988b8617292aa4e730d38854d1b81cdb9121a AS builder
WORKDIR /ew
RUN python -m venv /opt/venv
ENV PATH="/opt/venv/bin:$PATH" PIP_DISABLE_PIP_VERSION_CHECK=1
RUN python -m pip install --no-cache-dir --only-binary=:all: pip==26.3 setuptools==84.2.1 wheel==0.46.3 \
    && pip install --no-cache-dir fastapi "uvicorn[standard]" requests sqlalchemy "psycopg[binary]" pillow pandas "numpy<2.4" psycopg_pool
COPY . .
RUN python make_icons.py

FROM dhi.io/python:3.11-debian13@sha256:1bb857892e25f7df5c34a6bd5f8695a450e85c8ab8511c02f98ad9282943435e
# Retain access to existing root-owned volumes; nonroot requires an ownership migration.
USER 0
ARG APP_VERSION=dev
ENV APP_VERSION=$APP_VERSION PATH="/opt/venv/bin:$PATH"
WORKDIR /ew
COPY --from=builder /opt/venv /opt/venv
COPY --from=builder /ew /ew
EXPOSE 8502
CMD ["/opt/venv/bin/python", "-m", "uvicorn", "app:app", "--host", "0.0.0.0", "--port", "8502"]
