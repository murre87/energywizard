[Unit]
Description=Python Matter Server
After=network.target

[Service]
Type=simple
User=emil
WorkingDirectory=/home/emil/matter_server
Environment="CHIP_FACTORY_CONFIG_PATH=/home/emil/.matter_server/chip_factory.ini"
ExecStart=/home/emil/matter_server/venv/bin/python -m matter_server.server --storage-path /home/emil/.matter_server
Restart=always
RestartSec=5

[Install]
WantedBy=multi-user.target