PUMP_IP=
HA_IP=
POSTGRES_USER=
POSTGRES_PASSWORD=
POSTGRES_DB=
GEMINI_API_KEY=
EASEE_CHARGER_ID=
EASEE_CARPORT_ID=
HA_TOKEN=

# NIBE S-serie (S735/S1255/S1155/S320 m.fl.), lokalt REST-API - bara om
# heat_pump.driver: nibe_local i house_config.yaml. Aktiveras i pumpens
# installatörsmeny 7.5, som själv genererar användarnamn/lösenord.
# NIBE_LOCAL_TLS_PIN_SHA256: SHA-256-fingeravtryck av pumpens egna, självsignerade
# certifikat (t.ex. via "openssl s_client -connect <pump-ip>:8443" + "openssl x509
# -fingerprint -sha256"). Overifierat mot riktig hårdvara, se ROADMAP.md.
# NIBE_LOCAL_HOST=
# NIBE_LOCAL_PORT=8443
# NIBE_LOCAL_USERNAME=
# NIBE_LOCAL_PASSWORD=
# NIBE_LOCAL_TLS_PIN_SHA256=

# Valfritt: kör EnergyWizard under samma adress som din Home Assistant
# ("docker compose --profile ha-gateway up -d", se kunskapsbanken för guiden).
# Bara för Container-installationer UTAN Supervisor - har du Supervisor/HAOS,
# använd HA:s egen Ingress istället, det är enklare och säkrare.
# HA_GATEWAY_DOMAIN=ha.dittdomän.se
# HA_GATEWAY_CERT_DIR=/sökväg/till/din/cert-mapp (måste innehålla riktiga
#   fullchain.pem/privkey.pem, inte symlänkar som pekar utanför mappen)
# HA_GATEWAY_UPSTREAM_HOST=192.168.1.X (din HA:s lokala IP)
# HA_GATEWAY_UPSTREAM_PORT=8123
# HA_GATEWAY_UPSTREAM_PROTO=https (http om din HA inte terminerar egen TLS)
# HA_GATEWAY_PORT=8199 (testport innan du eventuellt flyttar din HA till den
#   här porten på riktigt - görs alltid manuellt av dig, aldrig automatiskt)

# Telemetri: PÅ SOM STANDARD, inget att sätta här för att den ska fungera.
# Skickar bara: en hashad, oåterkallelig husidentifierare (sha256 av house_id),
# vilka drivrutinkategorier som är aktiva (t.ex. "solar:solaredge" - inga
# entity-id:n/sensorvärden), feltyper vid kritiska fel i huvudloopen
# (exceptionens klassnamn, aldrig feltexten), en grov versionsindikator
# (git-commit-hash) och en tidsstämpel. Inget annat - ingen elprisdata, ingen
# sensorhistorik, ingen plats. Se smartbox/telemetry.py.
# TELEMETRY_OPT_IN=false   # avkommentera för att stänga av helt
# TELEMETRY_ENDPOINT=https://energywizzard.profitalgos.com/telemetry   # ändra bara om du kör din egen samlare

# Bara relevant om du kör din EGEN telemetry-collector (--profile telemetry-collector):
# skickar ett mejl EN gång per ny, unik installation (hashad husidentifierare) som
# rapporterar in för första gången. Av om SMTP_HOST/ALERT_EMAIL_TO saknas.
# SMTP_HOST=smtp.exempel.se
# SMTP_PORT=587
# SMTP_USER=
# SMTP_PASSWORD=
# SMTP_FROM=energywizard@exempel.se
# ALERT_EMAIL_TO=emil@exempel.se
