{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/murre87/energywizard/contracts/driver-command.schema.json",
  "title": "Driver command (core -> drivers)",
  "description": "Ett kommando från Core till en drivrutin: enhet, kommando och argument. Listan motsvarar drivrutinsgränssnittens skrivande metoder (smartbox/drivers/*.py); tests/test_contracts_drivers.py kräver att varje ny metod klassas som kommando eller icke-kommando.",
  "x-api-version": "1.0.0",
  "type": "object",
  "required": ["device", "command", "args"],
  "additionalProperties": false,
  "properties": {
    "device": {"enum": ["battery", "car", "charger", "heatpump", "solar", "spa"]},
    "command": {"type": "string"},
    "args": {"type": "object"},
    "id": {"type": "string", "description": "Valfritt id som svaret hänvisar till."}
  },
  "oneOf": [
    {"$ref": "#/$defs/battery.apply_intent"}, {"$ref": "#/$defs/battery.set_mode"},
    {"$ref": "#/$defs/car.set_climate"},
    {"$ref": "#/$defs/charger.set_limit_a"}, {"$ref": "#/$defs/charger.set_phases"}, {"$ref": "#/$defs/charger.turn_on"}, {"$ref": "#/$defs/charger.turn_off"},
    {"$ref": "#/$defs/heatpump.adjust_curve"}, {"$ref": "#/$defs/heatpump.set_curve_offset"}, {"$ref": "#/$defs/heatpump.reset_curve_offset"},
    {"$ref": "#/$defs/heatpump.pause"}, {"$ref": "#/$defs/heatpump.resume"}, {"$ref": "#/$defs/heatpump.set_hot_water_boost"},
    {"$ref": "#/$defs/heatpump.set_operating_mode"}, {"$ref": "#/$defs/heatpump.set_room_temp"}, {"$ref": "#/$defs/heatpump.set_heating_start_temp"},
    {"$ref": "#/$defs/heatpump.set_water_start_temp"}, {"$ref": "#/$defs/heatpump.set_water_stop_temp"},
    {"$ref": "#/$defs/solar.set_export_limit_pct"},
    {"$ref": "#/$defs/spa.set_target_temp"}, {"$ref": "#/$defs/spa.set_economy"}, {"$ref": "#/$defs/spa.set_plug_power"}
  ],
  "$defs": {
    "battery.apply_intent": {"properties": {"device": {"const": "battery"}, "command": {"const": "apply_intent"}, "args": {"type": "object", "required": ["intent"], "additionalProperties": false,
        "properties": {"intent": {"enum": ["auto", "hold", "idle", "charge", "discharge", "standby"]}, "power_w": {"type": ["number", "null"], "minimum": 0}}}}},
    "battery.set_mode": {"properties": {"device": {"const": "battery"}, "command": {"const": "set_mode"}, "args": {"type": "object", "required": ["mode"], "additionalProperties": false, "properties": {"mode": {"type": "string"}}}}},
    "car.set_climate": {"properties": {"device": {"const": "car"}, "command": {"const": "set_climate"}, "args": {"type": "object", "required": ["hvac_mode"], "additionalProperties": false,
        "properties": {"hvac_mode": {"type": "string"}, "temperature": {"type": ["number", "null"]}}}}},
    "charger.set_limit_a": {"properties": {"device": {"const": "charger"}, "command": {"const": "set_limit_a"}, "args": {"type": "object", "required": ["amps"], "additionalProperties": false,
        "properties": {"amps": {"type": "integer", "minimum": 0, "maximum": 32}, "reason": {"type": ["string", "null"]}}}}},
    "charger.set_phases": {"properties": {"device": {"const": "charger"}, "command": {"const": "set_phases"}, "args": {"type": "object", "required": ["phases"], "additionalProperties": false, "properties": {"phases": {"enum": [1, 3]}}}}},
    "charger.turn_on": {"properties": {"device": {"const": "charger"}, "command": {"const": "turn_on"}, "args": {"type": "object", "additionalProperties": false}}},
    "charger.turn_off": {"properties": {"device": {"const": "charger"}, "command": {"const": "turn_off"}, "args": {"type": "object", "additionalProperties": false}}},
    "heatpump.adjust_curve": {"properties": {"device": {"const": "heatpump"}, "command": {"const": "adjust_curve"}, "args": {"type": "object", "required": ["delta"], "additionalProperties": false, "properties": {"delta": {"type": "number"}}}}},
    "heatpump.set_curve_offset": {"properties": {"device": {"const": "heatpump"}, "command": {"const": "set_curve_offset"}, "args": {"type": "object", "required": ["offset"], "additionalProperties": false, "properties": {"offset": {"type": "number"}}}}},
    "heatpump.reset_curve_offset": {"properties": {"device": {"const": "heatpump"}, "command": {"const": "reset_curve_offset"}, "args": {"type": "object", "additionalProperties": false}}},
    "heatpump.pause": {"properties": {"device": {"const": "heatpump"}, "command": {"const": "pause"}, "args": {"type": "object", "required": ["minutes"], "additionalProperties": false, "properties": {"minutes": {"type": "number", "exclusiveMinimum": 0}}}}},
    "heatpump.resume": {"properties": {"device": {"const": "heatpump"}, "command": {"const": "resume"}, "args": {"type": "object", "additionalProperties": false}}},
    "heatpump.set_hot_water_boost": {"properties": {"device": {"const": "heatpump"}, "command": {"const": "set_hot_water_boost"}, "args": {"type": "object", "required": ["active"], "additionalProperties": false, "properties": {"active": {"type": "boolean"}}}}},
    "heatpump.set_operating_mode": {"properties": {"device": {"const": "heatpump"}, "command": {"const": "set_operating_mode"}, "args": {"type": "object", "required": ["mode"], "additionalProperties": false,
        "properties": {"mode": {"enum": ["off", "heat", "cool", "auto", "dhw", "heat_dhw", "cool_dhw", "auto_dhw"]}}}}},
    "heatpump.set_room_temp": {"properties": {"device": {"const": "heatpump"}, "command": {"const": "set_room_temp"}, "args": {"type": "object", "required": ["target_c"], "additionalProperties": false, "properties": {"target_c": {"type": "number"}}}}},
    "heatpump.set_heating_start_temp": {"properties": {"device": {"const": "heatpump"}, "command": {"const": "set_heating_start_temp"}, "args": {"type": "object", "required": ["target_c"], "additionalProperties": false, "properties": {"target_c": {"type": "number"}}}}},
    "heatpump.set_water_start_temp": {"properties": {"device": {"const": "heatpump"}, "command": {"const": "set_water_start_temp"}, "args": {"type": "object", "required": ["target_c"], "additionalProperties": false, "properties": {"target_c": {"type": "number"}}}}},
    "heatpump.set_water_stop_temp": {"properties": {"device": {"const": "heatpump"}, "command": {"const": "set_water_stop_temp"}, "args": {"type": "object", "required": ["target_c"], "additionalProperties": false, "properties": {"target_c": {"type": "number"}}}}},
    "solar.set_export_limit_pct": {"properties": {"device": {"const": "solar"}, "command": {"const": "set_export_limit_pct"}, "args": {"type": "object", "required": ["pct"], "additionalProperties": false, "properties": {"pct": {"type": "integer", "minimum": 0, "maximum": 100}}}}},
    "spa.set_target_temp": {"properties": {"device": {"const": "spa"}, "command": {"const": "set_target_temp"}, "args": {"type": "object", "required": ["temp_c"], "additionalProperties": false, "properties": {"temp_c": {"type": "number"}}}}},
    "spa.set_economy": {"properties": {"device": {"const": "spa"}, "command": {"const": "set_economy"}, "args": {"type": "object", "required": ["enable"], "additionalProperties": false, "properties": {"enable": {"type": "boolean"}}}}},
    "spa.set_plug_power": {"properties": {"device": {"const": "spa"}, "command": {"const": "set_plug_power"}, "args": {"type": "object", "required": ["on"], "additionalProperties": false, "properties": {"on": {"type": "boolean"}}}}}
  }
}
